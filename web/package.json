{
  "name": "proxystack-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && touch dist/.keep",
    "gen:api": "cd .. && go run ./cmd/proxystack-web openapi > web/openapi.json && cd web && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "naive-ui": "^2.45.3",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
