{
  "name": "proxystack-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && touch dist/.keep",
    "gen:api": "cd .. && go run ./cmd/proxystack-web openapi > web/openapi.json && cd web && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "naive-ui": "^2.45.3",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
