[Unit]
Description=proxystack-web management service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxystack-web
Group=proxystack-web
ExecStart=/opt/proxystack-web/bin/proxystack-web --base-dir /opt/proxystack-web serve
WorkingDirectory=/opt/proxystack-web
UMask=0027
# 自更新与迁移包恢复以退出码 75 退出，由 systemd 立即拉起新进程。
Restart=on-failure
RestartForceExitStatus=75
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/proxystack-web

[Install]
WantedBy=multi-user.target
