[Unit]
Description=proxystack-web mihomo %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxystack-web
Group=proxystack-web
ExecStart=/opt/proxystack-web/bin/mihomo -d /opt/proxystack-web/runtime/mihomo/%i -f /opt/proxystack-web/runtime/generated/mihomo/%i.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/proxystack-web
ReadWritePaths=/opt/proxystack-web/runtime/mihomo/%i

[Install]
WantedBy=multi-user.target
